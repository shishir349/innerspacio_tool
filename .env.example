# Copy to .env.local and fill in. Never commit real values. Leave Supabase blank to run in demo mode.

# Supabase (all three, or none). SERVICE_ROLE is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Room analysis / BOQ plan analysis / structure scan
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_STRUCTURE_MODEL=

# BOQ plan analysis provider: manus | anthropic (default: manus when its key exists)
BOQ_AI_PROVIDER=
BOQ_CONSENSUS_RUNS=3
MANUS_API_KEY=
MANUS_API_BASE=
MANUS_AGENT_PROFILE=

# Image generation: demo | stability | openai
IMAGE_GENERATION_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
OPENAI_INPUT_FIDELITY=high
STABILITY_API_KEY=
QUOTE_DAILY_IMAGE_CAP=100
