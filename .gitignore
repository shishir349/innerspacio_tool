# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local demo-mode data store (lib/data/demo-store.ts)
/.data/

# typescript
*.tsbuildinfo
next-env.d.ts

# third-party UI reference screenshots (not ours to publish)
/references/
/references_client_image/

# client / third-party pricing sheets and BOQ reference screenshots
/pricing/
/reference_BOQ/

# raw brand font files (licence: demo for personal use) - only the web subsets in app/fonts are used
/fonts/
